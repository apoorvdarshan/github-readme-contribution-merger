{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-contribution-merger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "github-contribution-merger.apoorvdarshan.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
